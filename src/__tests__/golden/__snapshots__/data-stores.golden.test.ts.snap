  "mecanica-32": {
    "acento": "#2A9D8F",
    "aplicaciones": [
      {
        "area": "Preamplificación de sensores",
        "ejemplo": "Un puente de galgas o un micrófono entregan señales de milivolts — un op-amp no inversor de alta Zin las amplifica sin cargar la fuente, el primer bloque de casi cualquier cadena de instrumentación.",
