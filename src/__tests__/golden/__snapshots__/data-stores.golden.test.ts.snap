  "mecanica-17": {
    "acento": "#2A9D8F",
    "aplicaciones": [
      {
        "area": "Fuentes de banco e instrumentación",
        "ejemplo": "Fuentes de banco y fuentes internas de equipo de laboratorio, instrumentación y control industrial que siguen usando regulación lineal por su bajo ruido, frente a fuentes conmutadas donde el ruido de conmutación es inaceptable.",
