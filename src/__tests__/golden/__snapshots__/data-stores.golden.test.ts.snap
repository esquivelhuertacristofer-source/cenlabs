    },
    {
      "accion": "Validar Gravedad",
      "id": 5,
      "mensaje": "Presiona Validar cuando tengas el valor de g calculado.",
      "pista": "Validar Gravedad",
      "tipo": "verificar",
    },
  ],
  "fisica-4": [
    {
      "id": 1,
