      "tipo": "accion",
    },
    {
      "accion": "Certificar Circuito",
      "id": 7,
      "mensaje": "Ingresa el valor de la resistencia que estás usando en el campo de texto y presiona "Validar V=IR". Esto certificará tu diseño en el sistema.",
      "pista": "Validar Ingeniería",
      "tipo": "verificar",
    },
    {
      "id": 8,
