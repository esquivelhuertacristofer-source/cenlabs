    "conceptos": [
      {
        "descripcion": "Media onda (1 diodo, rizo a 1× la frecuencia de línea), center-tap (2 diodos, rizo a 2×) y puente (4 diodos, rizo a 2× con la mitad del PIV que el center-tap).",
        "icono": "⚡",
        "nombre": "Las tres topologías",
