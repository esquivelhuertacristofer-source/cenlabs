  "mecanica-45": {
    "acento": "#3A6EA5",
    "aplicaciones": [
      {
        "area": "Diseño y selección de transformadores",
        "ejemplo": "Los fabricantes reportan Req, Xeq (o %Z), Rc y Xm en la hoja de datos precisamente porque provienen de estos dos ensayos de rutina — son la base para que el ingeniero de planta calcule regulación de voltaje y eficiencia esperadas sin ensayar la unidad bajo carga real.",
      },
      {
        "area": "Predicción de caída de tensión en alimentadores",
