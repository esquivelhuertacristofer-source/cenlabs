  "mecanica-31": {
    "acento": "#2A9D8F",
    "aplicaciones": [
      {
        "area": "Diagnóstico automotriz",
        "ejemplo": "Antes de reemplazar una ECU por sospecha de daño, confirmar que su alimentación, sus tierras y su referencia de 5 V están sanas — la mayoría de los "módulos dañados" resultan ser justamente esto.",
      },
      {
        "area": "Autotrónica de posventa",
