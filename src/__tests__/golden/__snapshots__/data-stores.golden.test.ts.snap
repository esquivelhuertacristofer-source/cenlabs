  "mecanica-69": {
    "acento": "#2A9D8F",
    "aplicaciones": [
      {
        "area": "Sintonía de receptores de radio",
        "ejemplo": "Un circuito RLC en paralelo sintonizado a la frecuencia de una estación selecciona esa señal y rechaza las demás; el Q del circuito determina qué tan bien separa estaciones cercanas en el cuadrante — exactamente la relación f₀/Δf que mides en este banco.",
      },
      {
        "area": "Corrección de factor de potencia y resonancia peligrosa",
