  "mecanica-68": {
    "acento": "#2A9D8F",
    "aplicaciones": [
      {
        "area": "Corrección del factor de potencia",
        "ejemplo": "Una carga inductiva industrial (motores, balastros) presenta θz>0: consume potencia reactiva que penaliza la factura eléctrica. Calcular el capacitor de corrección exacto exige resolver la misma ecuación de impedancia paralelo que practicas en este banco.",
      },
      {
        "area": "Diseño de filtros pasivos",
