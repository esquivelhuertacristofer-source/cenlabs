  "fisica-6": [
    {
      "id": 1,
      "mensaje": "¡Hola, {alumno}! Bienvenido a la boya experimental. Tu misión es utilizar el Principio de Arquímedes para determinar la densidad de un material desconocido.",
      "pista": "¡Bienvenida!",
