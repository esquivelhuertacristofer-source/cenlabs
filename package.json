{
  "name": "cen-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "gen:labs": "node scripts/gen-lab-registry.mjs",
    "gen:labs:check": "node scripts/gen-lab-registry.mjs --check",
    "gen:briefings": "node scripts/gen-lab-briefings.mjs",
    "gen:briefings:check": "node scripts/gen-lab-briefings.mjs --check",
    "new:lab": "node scripts/new-lab.mjs",
    "gen:portadas": "node scripts/portadas/capturar-portadas.mjs",
    "ver:fichas": "node scripts/portadas/maqueta-fichas.mjs",
    "predev": "node scripts/gen-lab-registry.mjs && node scripts/gen-lab-briefings.mjs",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/gen-lab-registry.mjs && node scripts/gen-lab-briefings.mjs",
    "build": "next build",
    "start": "next start",
    "cf:build": "node scripts/gen-lab-registry.mjs && node scripts/gen-lab-briefings.mjs && opennextjs-cloudflare build",
    "preview:cf": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy:cf": "npm run cf:build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "test": "jest",
    "voz:extraer": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/voz/extraer-voz.mjs > zz-voz.json",
    "voz:narrar": "python scripts/voz/narrar.py",
    "voz:manifiesto": "node scripts/voz/manifiesto-voz.mjs",
    "voz": "npm run voz:extraer && npm run voz:narrar && npm run voz:manifiesto",
    "auditar:labs": "node scripts/auditoria/barrido-labs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^9",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.103.0",
    "@types/katex": "^0.16.8",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.7.0",
    "next": "^15.1.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-katex": "^3.1.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jspdf-autotable": "^5.0.7",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.1",
    "typescript": "^5",
    "wrangler": "^4.109.0"
  }
}
