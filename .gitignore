# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
ENTREGA_CREDENTIALS.md
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

.vercel

# Generated credentials and pilot config — never commit
/output/
/scripts/piloto-config.ts
/docs/CREDENCIALES-PILOTO-001.md

# Insumos de currículas de mecánica — currículas del cliente, no commitear
# (se conserva solo el instructivo LEEME.md)
/docs/curriculas-mecanica/*
!/docs/curriculas-mecanica/LEEME.md
